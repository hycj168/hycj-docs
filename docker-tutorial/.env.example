# =============================================================================
# Docker 企业级环境变量配置文件示例
# =============================================================================
# 文件名称: .env.example
# 创建时间: $(date '+%Y-%m-%d %H:%M:%S')
# 适用环境: 企业级生产环境
# 功能描述: 定义数据库密码、配置参数等敏感信息
# 使用说明: 将此文件复制为 .env 并修改相应值
# 安全警告: 切勿将此文件提交到版本控制系统
# =============================================================================

# =============================================================================
# 基础配置 - 域名和时区
# =============================================================================
DOMAIN=your-company.com
TZ=Asia/Shanghai

# =============================================================================
# MySQL 数据库配置
# =============================================================================
# 根用户密码（必须修改）
MYSQL_ROOT_PASSWORD=YourSecureRootPassword2024!

# 应用数据库配置
MYSQL_DATABASE=enterprise_app
MYSQL_USER=app_user
MYSQL_PASSWORD=YourSecureAppPassword2024!

# 性能优化配置
MYSQL_INNODB_BUFFER_POOL_SIZE=1G
MYSQL_QUERY_CACHE_SIZE=64M
MYSQL_MAX_CONNECTIONS=500

# 访问控制配置
MYSQL_ROOT_HOST=localhost

# =============================================================================
# Redis 缓存配置
# =============================================================================
# 访问密码（必须修改）
REDIS_PASSWORD=YourSecureRedisPassword2024!

# 性能优化配置
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# =============================================================================
# MongoDB 数据库配置
# =============================================================================
# 管理员账户配置（必须修改）
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=YourSecureMongoPassword2024!

# 初始化数据库
MONGO_INITDB_DATABASE=admin

# 性能优化配置
MONGO_WIREDTIGER_CACHE_SIZE=1G

# =============================================================================
# PostgreSQL 数据库配置
# =============================================================================
# 数据库配置（必须修改）
POSTGRES_DB=enterprise_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YourSecurePostgresPassword2024!

# 性能优化配置
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1GB
POSTGRES_WORK_MEM=4MB
POSTGRES_MAINTENANCE_WORK_MEM=64MB
POSTGRES_MAX_CONNECTIONS=200

# =============================================================================
# Elasticsearch 搜索引擎配置
# =============================================================================
# 集群配置
ELASTIC_CLUSTER_NAME=enterprise-cluster
ELASTIC_NODE_NAME=elasticsearch-master

# 安全访问配置（必须修改）
ELASTIC_PASSWORD=YourSecureElasticPassword2024!

# =============================================================================
# MinIO 对象存储配置
# =============================================================================
# 管理员账户配置（必须修改）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=YourSecureMinIOPassword2024!

# =============================================================================
# 安全配置建议
# =============================================================================
# 
# 密码安全要求：
# 1. 至少 12 个字符
# 2. 包含大小写字母、数字和特殊字符
# 3. 不要使用常见单词或个人信息
# 4. 每个服务使用不同的密码
# 5. 定期更换密码（建议每 90 天）
# 
# 配置安全建议：
# 1. 启用 SSL/TLS 加密
# 2. 配置防火墙规则
# 3. 设置访问控制列表
# 4. 启用审计日志
# 5. 配置备份加密
# 6. 使用密钥管理服务
# 
# 生产环境注意事项：
# 1. 使用专用密钥管理服务
# 2. 配置监控告警
# 3. 定期安全扫描
# 4. 及时更新安全补丁
# 5. 进行安全审计
# =============================================================================