# ==================== Osmanthus Music Backend 环境变量配置 ====================
# 说明：请根据实际环境修改配置，然后重命名为 .env 文件
# 使用方法：
#   1. 复制此文件为 .env
#   2. 修改下面的配置值
#   3. 在 docker-compose.yml 文件目录下执行：docker-compose --env-file .env up -d
# =================================================================================

# ==================== 基础配置 ====================
# Spring 环境配置 (dev/test/uat/prod)
SPRING_PROFILES_ACTIVE=prod

# ==================== MySQL 数据库配置 ====================
# Root 用户密码（必须修改）
MYSQL_ROOT_PASSWORD=sakura_dev_root_2024

# 应用数据库配置
MYSQL_DATABASE=osmanthus_music_db
MYSQL_USER=osmanthus_user
MYSQL_PASSWORD=osmanthus_pass_2024

# ==================== Redis 配置 ====================
REDIS_PASSWORD=osmanthus_redis_2024

# ==================== MinIO 对象存储配置 ====================
# MinIO Root 用户配置（建议修改）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin2024

# 是否启用 MinIO（true/false）
MINIO_ENABLED=true

# ==================== JWT 安全配置 ====================
# JWT 密钥（生产环境必须使用强密钥，建议64位以上随机字符）
JWT_SECRET=OsmanthusMusicBackendSecretKeyForJWT2024PleaseChangeInProductionEnvironment

# ==================== Swagger/Knife4j 配置 ====================
# 是否启用 Swagger（开发环境建议 true，生产环境建议 false）
SWAGGER_ENABLED=false

# Swagger 访问用户名密码
SWAGGER_USERNAME=admin
SWAGGER_PASSWORD=123456

# ==================== 应用配置 ====================
# 应用端口（默认8080）
SERVER_PORT=8080

# 日志路径
LOG_PATH=/var/log/osmanthus

# ==================== 监控配置 ====================
# 是否启用 Prometheus 监控
PROMETHEUS_ENABLED=false

# ==================== 安全配置 ====================
# 数据库连接加密（如需要）
# DB_SSL_ENABLED=false
# DB_SSL_MODE=REQUIRED

# Redis SSL 配置
# REDIS_SSL_ENABLED=false

# ==================== 性能调优配置 ====================
# JVM 参数
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC -XX:+UseStringDeduplication -XX:+OptimizeStringConcat

# ==================== 开发环境配置示例 ====================
# 开发环境可以启用以下配置：
# SPRING_PROFILES_ACTIVE=dev
# SWAGGER_ENABLED=true
# PROMETHEUS_ENABLED=true
# MINIO_ENABLED=true

# ==================== 生产环境安全配置 ====================
# 生产环境请务必：
# 1. 修改所有默认密码
# 2. 使用强 JWT 密钥
# 3. 禁用 Swagger
# 4. 启用 SSL/TLS
# 5. 配置防火墙规则
# 6. 启用监控和日志收集